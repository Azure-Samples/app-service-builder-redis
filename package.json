{
  "name": "app-service-builder-redis",
  "version": "1.0.0",
  "description": "PulseBoard - Azure Managed Redis with App Service Builder and managed identity",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "start": "node server/index.js",
    "build": "npm run build --workspace client",
    "test": "node --test test/*.test.js",
    "test:redis": "node scripts/verify-redis.js",
    "dev": "concurrently \"npm run dev --workspace client\" \"node --watch server/index.js\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "@azure/msal-node@2": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
